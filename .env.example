# Codebase Reliability Investigator (CRI) environment template
# Copy to .env and fill in values. Do not commit .env.

# Provider: openai | anthropic
CRI_LLM_PROVIDER=openai

# Defaults if unset: gpt-4o-mini (openai) or claude-3-5-haiku-latest (anthropic)
CRI_LLM_MODEL=gpt-4o-mini

# Sampling. Baseline uses 0 for reproducibility.
CRI_LLM_TEMPERATURE=0
CRI_LLM_MAX_TOKENS=4096

# Optional OpenAI-compatible or Anthropic host override
# CRI_LLM_BASE_URL=https://api.openai.com/v1

# Character cap for the concatenated repo bundle. Repos over the cap are SKIPPED
# (not truncated). 200000 is far above the 12 synthetic cases.
CRI_MAX_BUNDLE_CHARS=200000

# API keys — required for the selected provider
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional declared prices for estimated cost (USD per 1M tokens).
# Leave empty to keep estimated_cost_usd null. Do not guess.
# CRI_USD_PER_MILLION_PROMPT_TOKENS=
# CRI_USD_PER_MILLION_COMPLETION_TOKENS=

CRI_BENCHMARK_ROOT=benchmark
CRI_OUTPUT_DIR=outputs
